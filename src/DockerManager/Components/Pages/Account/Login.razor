@page "/Account/Login"


@layout MainLayout

<div class="grid h-screen place-items-center">
    <div class="card bg-base-100 w-full max-w-sm shrink-0 shadow-2xl">
        <div class="card-body">
            <h2 class="card-title">Login</h2>
            <p>To use this application, you must be logged in.</p>
            <EditForm Model="LoginModel" method="post"> @* OnValidSubmit="RegisterUser">*@
                <DataAnnotationsValidator/>
                <fieldset class="fieldset">
                    <div>
                        <legend class="fieldset-legend">Email</legend>
                        <InputText @bind-Value="LoginModel.Email" id="LoginModel.Email" class="input validator"
                                   autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                        <ValidationMessage For="() => LoginModel.Email" class="validator-hint"/>
                    </div>
                    <div>
                        <legend class="fieldset-legend">Password</legend>
                        <InputText type="password" @bind-Value="LoginModel.Password" id="LoginModel.Password"
                                   class="input validator"
                                   autocomplete="new-password" aria-required="true" placeholder="Password"/>
                        <ValidationMessage For="() => LoginModel.Password" class="validator-hint"/>
                    </div>
                    <div>
                        <label class="label">
                            <InputCheckbox type="checkbox" class="checkbox" @bind-Value="LoginModel.RememberMe"
                                           id="LoginModel.RememberMe"/>
                            Remember me
                        </label>
                    </div>
                    <button type="submit" class="btn btn-neutral mt-4">Register</button>
                </fieldset>
            </EditForm>
        </div>
    </div>
</div>



