@page "/Containers/{ContainerName}"

<h3 class="font-bold text-3xl">Container details for: @ContainerName</h3>

<div class="divider pb-5"></div>

<div class="tabs tabs-border">
    <input type="radio" name="my_tabs_2" class="tab" aria-label="Overview"/>
    <div class="tab-content border-base-300 bg-base-200 p-5">
        We should show some overview information here, like the container name, image, state, and other details.
    </div>

    <input type="radio" name="my_tabs_2" class="tab" aria-label="Configuration"/>
    <div class="tab-content border-base-300 bg-base-200 p-5">
        Show some configuration details here, like environment variables, ports, volumes, etc.
    </div>

    <input type="radio" name="my_tabs_2" class="tab" aria-label="Terminal" checked="checked"/>
    <div class="tab-content border-base-300 bg-base-200 p-5">
        <div class="mockup-code w-full border border-secondary">
            <div class="flex">
                <pre class="text-success font-bold flex-none"><code>user@viix-container-manager</code></pre>
                <pre data-prefix="$" class="flex-initial -mr-2"><code>npm i daisyui</code></pre>
            </div>
            <div class="flex">
                <pre class="text-success font-bold flex-none"><code>user@viix-container-manager</code></pre>
                <pre data-prefix=">" class="text-warning flex-initial"><code>installing...</code></pre>
            </div>
            <div class="flex">
                <pre class="text-success font-bold flex-none"><code>user@viix-container-manager</code></pre>
                <pre data-prefix=">" class="text-success flex-initial"><code>Done!</code></pre>
            </div>
            <div class="flex">
                <pre class="text-success font-bold flex-none"><code>user@viix-container-manager</code></pre>
                <pre data-prefix=">" class="text-info flex-initial"><code><input type="text" class="input input-ghost"/></code></pre>
            </div>
        </div>
    </div>

    <input type="radio" name="my_tabs_2" class="tab" aria-label="Logs"/>
    <div class="tab-content border-base-300 bg-base-200  p-5">
        Show table of logs here, with options to filter by date, level, etc.
    </div>

    <input type="radio" name="my_tabs_2" class="tab" aria-label="Stats"/>
    <div class="tab-content border-base-300 bg-base-200 p-5">
        Live stats of the container, like CPU usage, memory usage, network I/O, etc.
    </div>
</div>

