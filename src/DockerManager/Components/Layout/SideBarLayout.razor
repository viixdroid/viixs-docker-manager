@inherits LayoutComponentBase

<div class="flex h-screen">
    <!-- Sidebar -->
    <nav class="@($"bg-gray-800 text-white flex-shrink-0 transition-all duration-300 {(_isCollapsed ? "w-16" : "w-64")}")">
        <button class="p-2 focus:outline-none" @onclick="ToggleSidebar">
            <!-- Hamburger icon -->
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
        @if (!_isCollapsed)
        {
            <div class="p-4 font-bold text-lg">App Name</div>
        }
        <ul>
            @foreach (var item in navigationMenuService.GetNavigationMenuItems())
            {
                <li class="px-4 py-2 hover:bg-gray-700 flex items-center">
                    <NavLink href="@item.Path" class="flex items-center">
                        <span class="@($"{item.Icon.IconString} text-2xl")"></span>
                        @if (!_isCollapsed)
                        {
                            <label class="px-3 text-base font-medium">@item.Name</label>
                        }
                    </NavLink>
                </li>
            }
        </ul>
    </nav>
    <!-- Main content -->
    <main class="flex-1 bg-gray-100 p-6 overflow-auto">
        @Body
    </main>
</div>