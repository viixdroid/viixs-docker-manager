@page "/Containers/{ContainerName}"

<h3 class="font-bold text-3xl">Container details for: @ContainerName</h3>

<div class="divider pb-5"></div>

<div class="p-tabs">
    <div class="p-tabs__list" role="tablist">
        <div class="p-tabs__item">
            <button class="p-tabs__link" role="tab" aria-selected="true" aria-controls="overview-tab" id="overview">
                Overview
            </button>
        </div>
        <div class="p-tabs__item">
            <button class="p-tabs__link" role="tab" aria-selected="false" aria-controls="configuration-tab"
                    id="configuration">
                Configuration
            </button>
        </div>
        <div class="p-tabs__item">
            <button class="p-tabs__link" role="tab" aria-selected="false" aria-controls="terminal-tab"
                    id="terminal">
                Terminal
            </button>
        </div>
        <div class="p-tabs__item">
            <button class="p-tabs__link" role="tab" aria-selected="false" aria-controls="logs-tab"
                    id="logs">
                Logs
            </button>
        </div>
        <div class="p-tabs__item">
            <button class="p-tabs__link" role="tab" aria-selected="false" aria-controls="stats-tab"
                    id="stats">
                Stats
            </button>
        </div>
    </div>

    <div tabindex="0" role="tabpanel" id="overview-tab" aria-labelledby="overview">
        We should show some overview information here, like the container name, image, state, and other details.
    </div>
    <div tabindex="0" role="tabpanel" id="configuration-tab" aria-labelledby="configuration">
        Show some configuration details here, like environment variables, ports, volumes, etc.
    </div>
    <div tabindex="0" role="tabpanel" id="terminal-tab" aria-labelledby="terminal">
        <div class="p-card u-no-padding">
            <div class="p-card__header">
                <h5 class="p-card__title">my-terminal</h5>
            </div>
            <div class="p-card__content">
                <textarea class="c-terminal-textarea" id="my-terminal-input" rows="10"></textarea>
            </div>
        </div>
    </div>
    <div tabindex="0" role="tabpanel" id="logs-tab" aria-labelledby="logs">
        Show table of logs here, with options to filter by date, level, etc.
    </div>
    <div tabindex="0" role="tabpanel" id="stats-tab" aria-labelledby="stats">
        Live stats of the container, like CPU usage, memory usage, network I/O, etc.
    </div>

</div>

