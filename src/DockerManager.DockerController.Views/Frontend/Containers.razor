@page "/"
@page "/Containers"
@using DockerManager.DockerControl.Models

<h3 class="font-bold text-3xl">Containers</h3>

<AuthorizeView>
    <NotAuthorized>
        <div class="grid h-full place-items-center">
            <div class="flex flex-col w-2/5 text-center">
                <p class="text-lg">Please log in to view the containers.</p>
                <GoToLoginButton/>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="p-card">
            <ul class="p-list p-list--divided">
                @{
                    foreach (var containerSummary in _containerSummaries)
                    {
                        <li class="p-list__item">
                            <div class="grid">
                                <div class="grid-row--75-25">
                                    <div class="grid-col">
                                        <a href="@($"/containers/{@containerSummary.CleanedName}")"><p
                                                class="p-heading--3 u-no-margin--bottom">@containerSummary.CleanedName</p>
                                        </a>
                                        <p class="u-text--muted u-no-margin--bottom">created
                                            at @($"{containerSummary.Created:g}") with image @containerSummary.Image</p>
                                        @foreach (var port in containerSummary.Ports)
                                        {
                                            if (port.IsIpV6())
                                            {
                                                continue;
                                            }

                                            <button class="p-chip">
                                                <span class="p-chip__value">
                                                    @port.GetFormattedPort()
                                                </span>
                                            </button>
                                        }
                                    </div>
                                    <div class="grid-col u-align--right u-align--center">
                                        @{
                                            if (containerSummary.State == ContainerState.Running)
                                            {
                                                <button class="p-button--positive has-icon">
                                                    <i class="p-icon--pause"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="p-button--positive has-icon">
                                                    <i class="p-icon--play"></i>
                                                </button>
                                            }
                                        }
                                        <button class="p-button has-icon"><i class="p-icon--stop"></i></button>
                                        <button class="p-button--negative has-icon"><i class="p-icon--delete"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                }
            </ul>
        </div>


    </Authorized>
</AuthorizeView>
